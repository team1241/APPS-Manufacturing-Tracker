# Copy to .env.local. Leave both blank to run the sample board.
# Never prefix secrets with NEXT_PUBLIC_. Never commit .env.local.
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
MONDAY_API_VERSION=2026-10

# Mfg/Mech Tracker column IDs. Run npm run monday:inspect for another board.
MONDAY_CATEGORY_COLUMN_ID=status
MONDAY_STATUS_COLUMN_ID=status_mkkz36j4
MONDAY_PRIORITY_COLUMN_ID=color_mm8zxr84
MONDAY_DRAWING_COLUMN_ID=files_mkmcj69m
MONDAY_COMPLETED_COLUMN_ID=date_mm8zvxe8

# Optional part details. Assignee accepts a People or Text column.
MONDAY_DESCRIPTION_COLUMN_ID=long_text_mkkz1t29
MONDAY_QUANTITY_COLUMN_ID=numbers_mkmdycs
MONDAY_DRAWING_STATUS_COLUMN_ID=color_mm07ej71
MONDAY_ASSIGNEE_COLUMN_ID=multiple_person_mm8zvc1c

# Server-side cache and browser polling interval (60–3600 seconds).
MONDAY_POLL_SECONDS=300
COMPLETED_RETENTION_HOURS=48

# Optional second board: one note per item name, optionally with a Date column.
MONDAY_NOTES_BOARD_ID=
MONDAY_NOTES_DATE_COLUMN_ID=
